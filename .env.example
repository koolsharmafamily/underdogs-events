# Underdogs — Mr. Dog AI Concierge Provider Configuration
# The API key lives on the server ONLY. Never commit .env.local or expose keys to the client.

# OpenAI-compatible API base URL (Groq or OpenRouter)
MRDOG_API_BASE=https://api.groq.com/openai/v1
# Server-side API key (Groq or OpenRouter). Leave empty for offline FAQ mock mode.
MRDOG_API_KEY=

# Primary and fallback model IDs
MRDOG_MODEL=llama-3.3-70b-versatile
MRDOG_MODEL_FALLBACK=llama-3.1-8b-instant

# Set to 1 to force offline mock mode regardless of API key presence
# MRDOG_MOCK=1
